# Zensar Content Studio - local configuration.
# Copy to `.env` and adjust. Relative paths are resolved from the application root.
# No cloud API keys are used or required by this application.

APP_ENV=local
DATABASE_PATH=./data/app.db

# Local LLM (Ollama). Leave OLLAMA_MODEL empty to pick one in Settings.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# Sentence-transformers model name (must already be in the local HF cache) or a local folder under ./models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

OUTPUT_DIR=./outputs
PROJECT_DIR=./projects
DATA_DIR=./data
BRANDS_DIR=./brands
TEMPLATES_DIR=./templates
MODELS_DIR=./models

# Leave empty to auto-detect (PATH, then the bundled imageio-ffmpeg binary)
FFMPEG_PATH=

OCR_ENABLED=true
TTS_ENABLED=true
# auto | sapi | piper | none
TTS_ENGINE=auto
# Optional Piper binary + voice model (.onnx) for higher quality offline narration
PIPER_PATH=
PIPER_VOICE=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
MAX_UPLOAD_MB=100
